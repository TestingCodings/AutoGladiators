<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:game="clr-namespace:TestMauiApp.Game"
             x:Class="TestMauiApp.MainPage"
             Title="AutoGladiators — Map Lab"
             BackgroundColor="#0C0E14">

    <Grid RowDefinitions="*,Auto">

        <game:TileMapView x:Name="MapView" Grid.Row="0" />

        <!-- Location banner (top-left overlay) -->
        <Border Grid.Row="0"
                Margin="14" Padding="14,7"
                HorizontalOptions="Start" VerticalOptions="Start"
                BackgroundColor="#D91A1E28" StrokeThickness="2" Stroke="#5AC8FA"
                StrokeShape="RoundRectangle 10">
            <Label x:Name="LocationLabel" Text="" TextColor="White"
                   FontSize="15" FontAttributes="Bold" />
        </Border>

        <!-- Bottom controls: D-pad (hold to walk) on the left, action button on the right -->
        <Grid Grid.Row="1" Padding="18" ColumnDefinitions="Auto,*,Auto" VerticalOptions="End">

            <Grid Grid.Column="0"
                  ColumnSpacing="10" RowSpacing="10"
                  ColumnDefinitions="66,66,66"
                  RowDefinitions="66,66,66">
                <Border x:Name="BtnUp"    Grid.Row="0" Grid.Column="1" Style="{StaticResource Dpad}">
                    <Label Text="▲" Style="{StaticResource DpadGlyph}"/>
                </Border>
                <Border x:Name="BtnLeft"  Grid.Row="1" Grid.Column="0" Style="{StaticResource Dpad}">
                    <Label Text="◀" Style="{StaticResource DpadGlyph}"/>
                </Border>
                <Border x:Name="BtnRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource Dpad}">
                    <Label Text="▶" Style="{StaticResource DpadGlyph}"/>
                </Border>
                <Border x:Name="BtnDown"  Grid.Row="2" Grid.Column="1" Style="{StaticResource Dpad}">
                    <Label Text="▼" Style="{StaticResource DpadGlyph}"/>
                </Border>
            </Grid>

            <Border x:Name="BtnAction" Grid.Column="2"
                    WidthRequest="86" HeightRequest="86"
                    VerticalOptions="End"
                    BackgroundColor="#274060" Stroke="#5AC8FA" StrokeThickness="3"
                    StrokeShape="RoundRectangle 43">
                <Label Text="A" TextColor="#EAF6FF" FontSize="30" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>
    </Grid>

    <ContentPage.Resources>
        <Style x:Key="Dpad" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#232634"/>
            <Setter Property="Stroke" Value="#3A3F52"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        </Style>
        <Style x:Key="DpadGlyph" TargetType="Label">
            <Setter Property="TextColor" Value="#E8ECF5"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentPage.Resources>

</ContentPage>
